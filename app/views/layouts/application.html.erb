<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Weather Forecast</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      body {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 25%, #f093fb 50%, #4facfe 75%, #00f2fe 100%);
        background-attachment: fixed;
        min-height: 100vh;
        color: #1a1a2e;
        font-family: 'Segoe UI', 'Helvetica Neue', system-ui, sans-serif;
      }
      .card {
        background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(255,255,255,0.88));
        border: 1px solid rgba(102,126,234,0.15);
        backdrop-filter: blur(12px);
        color: #1a1a2e;
        border-radius: 20px;
        box-shadow: 0 8px 32px rgba(102,126,234,0.15), 0 2px 8px rgba(0,0,0,0.08);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
      }
      .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(102,126,234,0.25), 0 4px 12px rgba(0,0,0,0.12);
      }
      .card-header {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-bottom: none;
        border-radius: 20px 20px 0 0 !important;
        color: white;
        font-weight: 600;
      }
      .card-footer {
        background: rgba(102,126,234,0.05);
        border-top: 1px solid rgba(102,126,234,0.1);
        border-radius: 0 0 20px 20px !important;
        color: #666;
      }
      .form-control {
        background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(240,243,255,0.95));
        border: 2px solid rgba(102,126,234,0.2);
        color: #1a1a2e;
        border-radius: 14px;
        font-weight: 500;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
      }
      .form-control:focus {
        background: rgba(255,255,255,0.98);
        border-color: #667eea;
        color: #1a1a2e;
        box-shadow: 0 0 0 4px rgba(102,126,234,0.15), inset 0 2px 4px rgba(0,0,0,0.02);
      }
      .form-control::placeholder { color: rgba(102,126,234,0.65); }
      .form-label {
        color: #1a1a2e;
        font-weight: 600;
      }
      .btn-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        border-radius: 14px;
        font-weight: 700;
        letter-spacing: 0.3px;
        box-shadow: 0 6px 20px rgba(102,126,234,0.35);
        transition: all 0.3s ease;
      }
      .btn-primary:hover {
        background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
        transform: translateY(-3px);
        box-shadow: 0 10px 28px rgba(102,126,234,0.45);
      }
      .btn-primary:active {
        transform: translateY(-1px);
      }
      .temp-display { font-size: 5.5rem; font-weight: 200; line-height: 1; letter-spacing: -4px; color: #667eea; }
      .forecast-card {
        background: linear-gradient(135deg, rgba(255,255,255,0.85), rgba(240,243,255,0.9));
        border: 2px solid rgba(102,126,234,0.1);
        border-radius: 16px;
        padding: 1.2rem 0.8rem;
        text-align: center;
        transition: all 0.3s ease;
        color: #1a1a2e;
      }
      .forecast-card:hover {
        transform: translateY(-6px);
        background: linear-gradient(135deg, rgba(255,255,255,0.95), rgba(240,243,255,0.98));
        border-color: rgba(102,126,234,0.3);
        box-shadow: 0 10px 28px rgba(102,126,234,0.2);
      }
      .badge-cached {
        background: linear-gradient(135deg, #fbc02d, #f9a825) !important;
        color: #fff !important;
        border: 2px solid rgba(255,255,255,0.4) !important;
        font-weight: 700 !important;
        text-shadow: 0 1px 2px rgba(0,0,0,0.2);
        box-shadow: 0 4px 12px rgba(251,192,45,0.3);
      }
      .badge-live {
        background: linear-gradient(135deg, #4caf50, #45a049) !important;
        color: #fff !important;
        border: 2px solid rgba(255,255,255,0.4) !important;
        font-weight: 700 !important;
        text-shadow: 0 1px 2px rgba(0,0,0,0.2);
        box-shadow: 0 4px 12px rgba(76,175,80,0.4);
      }
      .text-muted { color: #555 !important; font-weight: 500; }
      a {
        color: #2d1b4e;
        text-decoration: none;
        font-weight: 700;
        transition: color 0.2s ease;
        text-shadow: 0 1px 2px rgba(255,255,255,0.4);
      }
      a:hover { color: #1a1a2e; }
      .stat-label {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: rgba(102,126,234,0.7);
        font-weight: 700;
      }
      .stat-value {
        font-size: 1.4rem;
        font-weight: 700;
        color: #667eea;
      }
      h1, h2 { color: #1a1a2e; font-weight: 700; }
      h1.display-5 { color: #0d0d1f !important; font-weight: 700 !important; }
      .display-5 {
        color: #0d0d1f !important;
        text-shadow: 0 2px 8px rgba(102,126,234,0.2);
        font-weight: 700 !important;
      }
      /* Forecast page styling - Location info background */
      .row .col-lg-8 .mb-3 {
        background: rgba(255,255,255,0.72) !important;
        padding: 1.8rem !important;
        border-radius: 16px !important;
        margin-bottom: 1.5rem !important;
        backdrop-filter: blur(4px);
      }
      .row .col-lg-8 .mb-3 h2 {
        color: #0d0d1f !important;
        font-weight: 900 !important;
        margin-bottom: 0.5rem !important;
        font-size: 2.2rem !important;
      }
      .row .col-lg-8 .mb-3 .text-muted.small {
        color: #2d2d2d !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
      }
      .row .col-lg-8 .d-flex a {
        color: #2d1b4e !important;
        font-weight: 800 !important;
      }
      .container > div > div > .text-center {
        filter: drop-shadow(0 2px 4px rgba(0,0,0,0.08));
        background: rgba(255, 255, 255, 0.7);
        padding: 2rem;
        border-radius: 20px;
        margin-bottom: 2rem;
      }
      .container > div > div > .text-center h1 {
        font-size: 3rem;
        color: #0d0d1f;
        text-shadow: 0 1px 3px rgba(102,126,234,0.15);
        font-weight: 800;
        margin-bottom: 0.5rem;
      }
      .container > div > div > .text-center p {
        color: #333;
        font-size: 1.1rem;
        font-weight: 500;
      }
      .container > div > div > .text-center > div:first-child {
        font-size: 4rem;
        line-height: 1;
        margin-bottom: 1rem;
      }
      .alert-danger {
        background: linear-gradient(135deg, rgba(229,115,115,0.1), rgba(244,67,54,0.08)) !important;
        border: 1.5px solid rgba(244,67,54,0.3) !important;
        color: #c62828 !important;
        border-radius: 14px !important;
      }
    </style>
  </head>

  <body>
    <header>
      <span class="logo">⛅</span>
      <h1>Weather Forecast</h1>
    </header>

    <div class="container">
      <% if flash[:alert] %>
        <div class="alert"><%= flash[:alert] %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
